{
  "name": "energy-price-graph-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card showing a 24h half-hourly energy price graph (Octopus Energy friendly)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/energy-price-graph-card.ts --bundle --minify --format=esm --target=es2021 --legal-comments=none --outfile=dist/energy-price-graph-card.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
